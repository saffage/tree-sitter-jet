{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "jet",
      "camelcase": "Jet",
      "title": "Jet",
      "scope": "source.jet",
      "file-types": [
        "jet"
      ],
      "injection-regex": "^jet$",
      "class-name": "TreeSitterJet"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Jet grammar for tree-sitter",
    "authors": [
      {
        "name": "saffage",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-jet",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}